// Web de Shard en Cloudflare: Worker solo con assets estáticos.
// Publicar: npx wrangler deploy (desde web/), tras `npx wrangler login`.
{
  "name": "shard-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "shardlauncher.com", "custom_domain": true },
    { "pattern": "www.shardlauncher.com", "custom_domain": true }
  ]
}
