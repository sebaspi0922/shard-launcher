// Estados y avisos: vacío, error, carga, aviso breve (SnackBar) y diálogo.

import { Palette, Theme, Type } from "../theme.slint";
import { Txt, Para, Wrapped, Icon, Spinner } from "base.slint";
import { FilledButton, TextButton } from "buttons.slint";
import { TipArea } from "common.slint";

// EmptyState (common.dart): icono en caja de acento, título, texto y acción.
export component EmptyState inherits VerticalLayout {
    in property <string> icon;
    in property <string> title;
    in property <string> body;
    in property <string> action;
    in property <string> action-icon;
    in property <length> action-icon-size: 20px;
    callback act;
    alignment: center;
    accessible-role: groupbox;
    accessible-label: title;
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            width: 380px;
            spacing: 0;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: Theme.radius-panel;
                    // withValues(alpha: 0.6) reemplaza el alfa (no lo multiplica).
                    background: Palette.accent-container.with-alpha(0.6);
                    border-width: 1px;
                    border-color: Palette.accent.with-alpha(0.25);
                    Icon { glyph: root.icon; size: 30px; color: Palette.accent; }
                }
            }
            Rectangle { height: 20px; }
            Wrapped { text: root.title; style: Type.title-large; color: Palette.text; horizontal-alignment: center; spaced: true; }
            Rectangle { height: 8px; }
            Wrapped { text: root.body; horizontal-alignment: center; spaced: true; }
            if root.action != "": VerticalLayout {
                Rectangle { height: 20px; }
                HorizontalLayout {
                    alignment: center;
                    FilledButton { text: root.action; icon: root.action-icon; icon-size: root.action-icon-size; accessible-id: "empty-action"; clicked => { root.act(); } }
                }
            }
        }
    }
}

// ErrorNote: caja roja con el texto del error y «Detalles» desplegable.
export component ErrorNote inherits Rectangle {
    in property <string> message;
    in property <string> detail;
    in property <string> details-label;
    in-out property <bool> open;
    border-radius: Theme.radius-control;
    background: Palette.danger.with-alpha(0.10);
    border-width: 1px;
    border-color: Palette.danger.with-alpha(0.35);
    accessible-role: text;
    accessible-label: message;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            Icon { glyph: "\u{f8b6}"; size: 18px; color: Palette.danger; }
            Para { text: root.message; color: Palette.text; horizontal-stretch: 1; }
            if root.detail != "": Rectangle {
                width: label.preferred-width + 12px;
                label := Text {
                    text: root.details-label;
                    font-family: "Inter";
                    font-size: Type.label-medium.size;
                    font-weight: Type.label-medium.weight;
                    color: Palette.text-secondary;
                    font-italic: false;
                }
                TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
            }
        }
        if root.open && root.detail != "": Text {
            text: root.detail;
            font-family: "JetBrains Mono";
            font-size: 11.5px;
            color: Palette.text-secondary;
            wrap: word-wrap;
        }
    }
}

// Carga a pantalla completa.
export component Loading inherits Rectangle {
    Spinner { }
}

// SnackBar flotante (ancho 420, superficie 3 sobre fondo profundo).
export component Snackbar inherits Rectangle {
    in property <string> message;
    in property <bool> error;
    in property <bool> shown;
    width: 420px;
    height: row.preferred-height;
    border-radius: Theme.radius-card;
    background: Theme.blend(Palette.surface3, Palette.background-deep);
    border-width: 1px;
    border-color: Palette.border-strong;
    opacity: shown ? 1 : 0;
    animate opacity { duration: Theme.medium; }
    accessible-role: text;
    accessible-label: message;
    row := HorizontalLayout {
        padding: 14px;
        spacing: 10px;
        Icon {
            glyph: root.error ? "\u{f8b6}" : "\u{f0be}";
            size: 18px;
            color: root.error ? Palette.danger : Palette.success;
        }
        Para { text: root.message; color: Palette.text; horizontal-stretch: 1; }
    }
}

// Diálogo modal (DialogThemeData): velo, panel con borde fuerte y sombra.
// El contenido va como hijo (@children) dentro del panel.
export component AppDialog inherits Rectangle {
    in property <string> title;
    in property <length> panel-width: 440px;
    callback dismissed;
    background: #00000080;
    accessible-role: none;
    TouchArea { clicked => { root.dismissed(); } }
    panel := Rectangle {
        width: min(root.panel-width, root.width - 48px);
        height: body.preferred-height;
        border-radius: Theme.radius-panel;
        background: Theme.blend(Palette.surface2, Palette.background);
        border-width: 1px;
        border-color: Palette.border-strong;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: Theme.shadow-dialog-blur;
        drop-shadow-offset-y: Theme.shadow-dialog-y;
        accessible-role: groupbox;
        accessible-label: root.title;
        TouchArea { }
        body := VerticalLayout {
            padding: 24px;
            spacing: 12px;
            if root.title != "": Txt { text: root.title; style: Type.title-large; }
            @children
        }
    }
}

// Diálogo de formulario (AppDialog de common.dart): velo, panel centrado de
// ancho máximo `panel-width`, relleno 24/24/24/20, cabecera con icono de
// acento y título, 16 hasta el cuerpo. El cuerpo y las acciones van como
// hijos; para las acciones, `DialogActions` (24 por encima, a la derecha).
export component FormDialog inherits Rectangle {
    in property <string> title;
    in property <string> icon;
    in property <length> panel-width: 440px;
    // `false` = el clic en el velo no cierra (login de Microsoft).
    in property <bool> dismissible: true;
    callback dismissed;
    background: #00000080;
    accessible-role: none;
    TouchArea { clicked => { if root.dismissible { root.dismissed(); } } }
    panel := Rectangle {
        width: min(root.panel-width, root.width - 48px);
        height: body.preferred-height;
        border-radius: Theme.radius-panel;
        background: Theme.blend(Palette.surface2, Palette.background);
        border-width: 1px;
        border-color: Palette.border-strong;
        drop-shadow-color: Theme.shadow;
        drop-shadow-blur: Theme.shadow-dialog-blur;
        drop-shadow-offset-y: Theme.shadow-dialog-y;
        accessible-role: groupbox;
        accessible-label: root.title;
        accessible-id: "dialog";
        TouchArea { }
        body := VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 24px;
            padding-bottom: 20px;
            HorizontalLayout {
                spacing: 12px;
                if root.icon != "": Icon { glyph: root.icon; size: 22px; color: Palette.accent; y: (parent.height - self.height) / 2; }
                Txt { text: root.title; style: Type.title-large; accessible-id: "txt-dialog-title"; horizontal-stretch: 1; }
            }
            Rectangle { height: 16px; }
            @children
        }
    }
}

// Fila de acciones de un FormDialog: a la derecha, 8 entre botones.
export component DialogActions inherits HorizontalLayout {
    alignment: end;
    spacing: 8px;
    padding-top: 24px;
}

// confirm() de common.dart: título, texto, «Cancelar» y la acción.
export component ConfirmDialog inherits FormDialog {
    in property <string> body;
    in property <string> action;
    in property <string> cancel-label;
    in property <bool> danger;
    callback accepted;
    panel-width: 420px;
    Para { text: root.body; color: Palette.text; }
    DialogActions {
        TextButton { text: root.cancel-label; height: 48px; clicked => { root.dismissed(); } }
        FilledButton { text: root.action; danger: root.danger; clicked => { root.accepted(); } }
    }
}

// IconButton de cerrar compacto (iconSize 18, VisualDensity.compact).
export component CloseButton inherits Rectangle {
    callback clicked;
    width: 40px;
    height: 40px;
    accessible-role: button;
    accessible-label: @tr("close");
    accessible-action-default => { clicked(); }
    Rectangle {
        width: 32px;
        height: 32px;
        border-radius: Theme.radius-control;
        background: ta.has-hover ? Palette.surface2 : transparent;
        Icon { glyph: "\u{e5cd}"; size: 18px; }
    }
    ta := TipArea { tip: @tr("close"); mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Último fallo de lanzamiento o de partida de una instancia
// (launch_feedback.dart LaunchFailureNote).
export struct LaunchFailure {
    present: bool,
    title: string,
    // Texto del error o código de salida e informe (puede tener «\n»).
    detail: string,
    // `kind: mensaje` del núcleo, en monoespaciada.
    tech: string,
    // El juego se cerró mal: ofrece Diagnosticar y Ver registros.
    crashed: bool,
}

export component LaunchFailureNote inherits Rectangle {
    in property <LaunchFailure> failure;
    in property <bool> show-logs-link: true;
    callback dismissed;
    callback diagnose;
    callback show-logs;
    height: lay.preferred-height + 2px;
    border-radius: Theme.radius-card;
    background: Theme.blend(Palette.danger.with-alpha(0.14), #0000008C);
    border-width: 1px;
    border-color: Palette.danger.with-alpha(0.45);
    accessible-role: groupbox;
    accessible-label: failure.title;
    lay := HorizontalLayout {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        padding-left: 16px;
        padding-top: 12px;
        padding-right: 8px;
        padding-bottom: 12px;
        spacing: 0;
        VerticalLayout {
            alignment: start;
            padding-top: 1px;
            Icon { glyph: "\u{f8b6}"; size: 20px; color: Palette.danger; }
        }
        Rectangle { width: 12px; }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: start;
            Txt { text: root.failure.title; style: Type.title-small; }
            if root.failure.detail != "": VerticalLayout {
                Rectangle { height: 2px; }
                Wrapped { text: root.failure.detail; style: Type.body-small; }
            }
            if root.failure.tech != "": VerticalLayout {
                Rectangle { height: 4px; }
                Wrapped {
                    text: root.failure.tech;
                    font-family: "JetBrains Mono";
                    natural: 1.32;
                    style: { size: 11px, weight: 400, line-height: 1.45, letter-spacing: 0 };
                    color: Palette.text-muted;
                    max-lines: 2;
                }
            }
            if root.failure.crashed: HorizontalLayout {
                alignment: start;
                padding-top: 8px;
                spacing: 4px;
                TextButton { text: @tr("doctorDiagnose"); icon: "\u{f805}"; icon-size: 16px; pad: 8px; tint: Palette.text; clicked => { root.diagnose(); } }
                if root.show-logs-link: TextButton { text: @tr("launchSeeLogs"); icon: "\u{eb8e}"; icon-size: 16px; pad: 8px; tint: Palette.text; clicked => { root.show-logs(); } }
            }
        }
        CloseButton { clicked => { root.dismissed(); } }
    }
}

