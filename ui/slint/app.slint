// Ventana principal de Shard: marco (fondo, raíl, barra de título), rutas,
// diálogo de cierre, avisos y bandeja.

import { Palette, Theme, Type } from "theme.slint";
import { Icons } from "icons.slint";
import { Fmt } from "fmt.slint";
import { Txt, Para } from "components/base.slint";
import { FilledButton, OutlinedButton, TextButton, Checkbox, LaunchState, LaunchPhase } from "components/buttons.slint";
import { EmptyState, AppDialog, Snackbar } from "components/feedback.slint";
import { Atmosphere, NavRail, TitleBar, Route, AccountChip, Activity } from "components/shell.slint";
import { InstancesPage, InstancesState, InstanceItem, LoadState } from "screens/instances.slint";
import { AccountsLayer, AccountsState, AccountItem, LoginPhase } from "screens/accounts.slint";
import { SkinsPage, SkinsLayer, SkinsState, CapeItem, SkinView } from "screens/skins.slint";
import { HomePage, HomeState, ServerItem } from "screens/home.slint";
import { LaunchFailure } from "components/feedback.slint";
import { Notices, UpdatePhase, UpdateBanner, CrashBanner } from "components/banners.slint";
import { TipLayer, Tips } from "components/common.slint";
import { SelectMenuLayer, SelectMenu, SelectOption } from "components/select.slint";

export { Palette, Theme, Fmt, Route, AccountChip, Activity, InstancesState, InstanceItem, LoadState, LaunchState, LaunchPhase,
    HomeState, ServerItem, LaunchFailure, Notices, UpdatePhase, Tips }
export { AccountsState, AccountItem, LoginPhase, SkinsState, CapeItem, SkinView }
export { SelectMenu, SelectOption }

// Fondo de la app (backdrop.dart): el del estilo o una imagen propia.
export enum BackdropKind {
    // Grafito: formas que derivan.
    atmosphere,
    // Una imagen ya pintada por Rust (paisaje, aurora, imagen propia).
    image,
    // Sebaspi: halo (imagen) y esfera ASCII que gira.
    sphere,
}

export global Backdrop {
    in property <BackdropKind> kind: BackdropKind.atmosphere;
    in property <image> base;
    // Oscurecido con el tinte del fondo (paisaje e imagen propia); < 0 = sin él.
    in property <float> dim: -1;
    in property <image> sphere;
    in property <length> sphere-x;
    in property <length> sphere-y;
    // `true` = sin fondo (captura para la web).
    in property <bool> hidden;
}

// Contenedor de una sección: entra con un fundido (CustomTransitionPage de
// go_router con FadeTransition, 260 ms).
component PageFade inherits Rectangle {
    property <bool> shown;
    opacity: shown ? 1 : 0;
    animate opacity { duration: Theme.motion ? Theme.page : 0ms; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
    init => { shown = true; }
    @children
}

// Una zona del borde para redimensionar la ventana sin marco.
export enum ResizeEdge { n, s, e, w, ne, nw, se, sw }

component ResizeHandle inherits TouchArea {
    in property <ResizeEdge> edge;
    callback start(ResizeEdge);
    mouse-cursor: edge == ResizeEdge.n || edge == ResizeEdge.s ? MouseCursor.ns-resize
        : edge == ResizeEdge.e || edge == ResizeEdge.w ? MouseCursor.ew-resize
        : edge == ResizeEdge.ne || edge == ResizeEdge.sw ? MouseCursor.nesw-resize : MouseCursor.nwse-resize;
    pointer-event(e) => {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            root.start(root.edge);
        }
    }
}

export component MainWindow inherits Window {
    title: "Shard";
    icon: @image-url("../img/shard-512.png");
    no-frame: true;
    preferred-width: 1280px;
    preferred-height: 800px;
    // Con la escala de UI por debajo de 1 la ventana mide más píxeles
    // lógicos: el mínimo sigue siendo 960 × 600 a la escala del sistema.
    min-width: 960px / Theme.ui-scale;
    min-height: 600px / Theme.ui-scale;
    default-font-family: "Inter";
    background: Backdrop.hidden ? transparent : Palette.background;

    in-out property <Route> route: Route.home;
    in property <AccountChip> account;
    in property <Activity> activity;
    in property <bool> is-maximized;
    // Fondo: animado o quieto en un instante dado (modo rendimiento, capturas).
    in property <bool> animate-background: true;
    in property <duration> background-still-at: 0ms;
    // Diálogo «¿Cerrar Shard?» (close_behavior = preguntar).
    in-out property <bool> close-dialog-open;
    // Aviso breve.
    in property <string> toast-message;
    in property <bool> toast-error;
    in property <bool> toast-shown;

    callback minimize;
    callback toggle-max;
    callback close-requested;
    // quit = salir; si no, segundo plano. remember = guardar la elección.
    callback close-chosen(bool, bool);
    callback account-clicked;
    callback activity-clicked(string);
    callback route-changed(Route);
    // Tamaño lógico nuevo (escala de UI, fondos pintados en Rust).
    callback resized(length, length);
    // Empieza a redimensionar desde un borde (ventana sin marco).
    callback resize-start(ResizeEdge);
    in property <bool> resizable: true;

    changed width => { root.resized(self.width, self.height); }
    changed height => { root.resized(self.width, self.height); }

    if !Backdrop.hidden && Backdrop.kind == BackdropKind.atmosphere: Atmosphere {
        animate: root.animate-background;
        still-at: root.background-still-at;
    }
    if !Backdrop.hidden && Backdrop.kind != BackdropKind.atmosphere: Rectangle {
        background: Palette.background-deep;
        Image {
            width: parent.width;
            height: parent.height;
            source: Backdrop.base;
            image-fit: fill;
            accessible-role: none;
        }
        if Backdrop.kind == BackdropKind.sphere: Image {
            x: Backdrop.sphere-x;
            y: Backdrop.sphere-y;
            source: Backdrop.sphere;
            accessible-role: none;
        }
        // Oscurecido: más a la izquierda, donde está el raíl.
        if Backdrop.dim >= 0: Rectangle {
            background: @linear-gradient(90deg,
                Palette.background-deep.with-alpha(min(0.95, Backdrop.dim + 0.15)) 0%,
                Palette.background-deep.with-alpha(Backdrop.dim) 45%,
                Palette.background-deep.with-alpha(Backdrop.dim) 100%);
        }
    }
    NavRail {
        x: 0;
        height: parent.height;
        route: root.route;
        account: root.account;
        accessible-id: "rail";
        navigate(r) => {
            root.route = r;
            root.route-changed(r);
        }
        account-clicked => {
            AccountsState.panel-open = true;
            root.account-clicked();
        }
        toggle-max => { root.toggle-max(); }
    }
    Rectangle {
        x: 76px;
        width: parent.width - 76px;
        TitleBar {
            y: 0;
            maximized: root.is-maximized;
            activity: root.activity;
            activity-label: root.activity.phase == LaunchPhase.preparing ? @tr("launchPreparing")
                : root.activity.phase == LaunchPhase.downloading ? @tr("launchDownloading", root.activity.done, root.activity.total)
                : root.activity.phase == LaunchPhase.starting ? @tr("launchStarting") : @tr("launchRunning");
            accessible-id: "titlebar";
            minimize => { root.minimize(); }
            toggle-max => { root.toggle-max(); }
            close => { root.close-requested(); }
            activity-clicked => { root.activity-clicked(root.activity.instance-id); }
        }
        Rectangle {
            y: 44px;
            height: parent.height - 44px;
            // Cambio de sección: la nueva entra con un fundido de 260 ms.
            if root.route == Route.home: PageFade { HomePage { account: root.account; } }
            if root.route == Route.instances: PageFade { InstancesPage { } }
            if root.route == Route.skins: PageFade { SkinsPage { } }
            // Pantallas de fases siguientes: solo su título por ahora.
            if root.route != Route.instances && root.route != Route.home && root.route != Route.skins: EmptyState {
                icon: root.route == Route.content ? Icons.extension
                    : root.route == Route.servers ? Icons.dns
                    : root.route == Route.skins ? Icons.checkroom : Icons.settings;
                title: root.route == Route.content ? @tr("navContent")
                    : root.route == Route.servers ? @tr("navServers")
                    : root.route == Route.skins ? @tr("navSkins") : @tr("navSettings");
                body: "";
            }
        }
    }
    // Avisos de versión nueva y de cierre inesperado (abajo a la derecha).
    VerticalLayout {
        x: parent.width - 400px - 24px;
        y: parent.height - self.preferred-height - 24px;
        width: 400px;
        height: self.preferred-height;
        // Flutter deja el hueco aunque el aviso de abajo esté oculto.
        spacing: 12px;
        UpdateBanner { accessible-id: "update-banner"; }
        CrashBanner { accessible-id: "crash-banner"; }
    }
    AccountsLayer { }
    SkinsLayer { }
    Snackbar {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px;
        message: root.toast-message;
        error: root.toast-error;
        shown: root.toast-shown;
        accessible-id: "toast";
    }
    if root.close-dialog-open: AppDialog {
        title: @tr("closeDialogTitle", "Shard");
        accessible-id: "close-dialog";
        dismissed => { root.close-dialog-open = false; }
        Para { text: @tr("closeDialogBody"); }
        remember := Checkbox { text: @tr("closeDialogRemember"); }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            padding-top: 8px;
            TextButton {
                text: @tr("cancel");
                clicked => { root.close-dialog-open = false; }
            }
            OutlinedButton {
                text: @tr("closeDialogMinimize");
                clicked => {
                    root.close-dialog-open = false;
                    root.close-chosen(false, remember.checked);
                }
            }
            FilledButton {
                text: @tr("closeDialogQuit");
                clicked => {
                    root.close-dialog-open = false;
                    root.close-chosen(true, remember.checked);
                }
            }
        }
    }
    // Menú de un SelectButton abierto (encima de diálogos y paneles).
    SelectMenuLayer { }
    TipLayer { }
    // Bordes para redimensionar (sin marco no los pone el sistema).
    if root.resizable && !root.is-maximized: Rectangle {
        ResizeHandle { edge: ResizeEdge.n; x: 8px; y: 0; width: parent.width - 16px; height: 4px; start(e) => { root.resize-start(e); } }
        ResizeHandle { edge: ResizeEdge.s; x: 8px; y: parent.height - 4px; width: parent.width - 16px; height: 4px; start(e) => { root.resize-start(e); } }
        ResizeHandle { edge: ResizeEdge.w; x: 0; y: 8px; width: 4px; height: parent.height - 16px; start(e) => { root.resize-start(e); } }
        ResizeHandle { edge: ResizeEdge.e; x: parent.width - 4px; y: 8px; width: 4px; height: parent.height - 16px; start(e) => { root.resize-start(e); } }
        ResizeHandle { edge: ResizeEdge.nw; x: 0; y: 0; width: 8px; height: 8px; start(e) => { root.resize-start(e); } }
        ResizeHandle { edge: ResizeEdge.ne; x: parent.width - 8px; y: 0; width: 8px; height: 8px; start(e) => { root.resize-start(e); } }
        ResizeHandle { edge: ResizeEdge.sw; x: 0; y: parent.height - 8px; width: 8px; height: 8px; start(e) => { root.resize-start(e); } }
        ResizeHandle { edge: ResizeEdge.se; x: parent.width - 8px; y: parent.height - 8px; width: 8px; height: 8px; start(e) => { root.resize-start(e); } }
    }
}

// Icono de la bandeja (tray_controller.dart): abrir, jugar la última
// instancia y salir.
export component ShardTray inherits SystemTrayIcon {
    icon: @image-url("../img/shard-512.png");
    tooltip: "Shard";
    // Nombre de la última instancia; vacío = sin «Jugar».
    in property <string> last-instance;
    callback open;
    callback play-last;
    callback quit;
    clicked => { open(); }
    Menu {
        MenuItem { title: @tr("trayOpen", "Shard"); activated => { root.open(); } }
        if root.last-instance != "": MenuItem {
            title: @tr("trayPlay", root.last-instance);
            activated => { root.play-last(); }
        }
        MenuItem { title: @tr("trayQuit"); activated => { root.quit(); } }
    }
}
