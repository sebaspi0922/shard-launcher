// Ajustes (settings/settings_page.dart, appearance_group.dart,
// java_group.dart): general, apariencia, juego, Java, descargas,
// integraciones y acerca de. Rust (`settings.rs`) rellena `SettingsState` y
// guarda cada cambio.

import { AboutSlint } from "std-widgets.slint";
import { Palette, Theme, Type } from "../theme.slint";
import { Icons } from "../icons.slint";
import { Fmt } from "../fmt.slint";
import { Txt, Wrapped, Icon, Spinner } from "../components/base.slint";
import { FilledButton, OutlinedButton, TextButton } from "../components/buttons.slint";
import { TextField } from "../components/inputs.slint";
import { ErrorNote, ConfirmDialog } from "../components/feedback.slint";
import { Panel, Tag, ColorBadge } from "../components/panels.slint";
import { TonalIconButton, TipArea } from "../components/common.slint";
import { BrandMark, Atmosphere } from "../components/shell.slint";
import { Switch, Slider, SegmentedButton, ValueBox, MemorySlider, SettingRow, Divider } from "../components/controls.slint";
import { Notices, UpdatePhase } from "../components/banners.slint";
import { CurseforgeKey } from "../components/curseforge_key.slint";
import { LoadState } from "instances.slint";

// Miniatura de un estilo (StylePreview): su fondo quieto pintado por Rust a
// escala de 1280 × 800 y el botón de su acento.
export struct StyleCard {
    name: string,
    art: image,
    // Graphite pinta sus formas en Slint (`Atmosphere`), no con imagen.
    atmosphere: bool,
    background: color,
    accent: color,
    // Radio del control del estilo (el botón de muestra usa ×3).
    radius: length,
}

// Una Java detectada (JavaView).
export struct JavaItem {
    major: int,
    // «21.0.5 · Eclipse Adoptium».
    title: string,
    path: string,
    // 0 gestionada, 1 elegida a mano, 2 del sistema.
    source: int,
}

// Botón «Java N» de instalar.
export struct JavaInstallItem {
    major: int,
    installed: bool,
    installing: bool,
    // 0..1; < 0 = sin progreso conocido.
    fraction: float,
}

export global SettingsState {
    in property <LoadState> state: LoadState.loading;
    in property <string> error-message;
    in property <string> error-detail;
    // Desplazamiento de la página (las escenas lo fijan).
    in-out property <length> scroll;

    // General. Idioma: 0 sistema, 1 español, 2 inglés. Cierre: 0 preguntar,
    // 1 segundo plano, 2 salir.
    in property <int> language;
    in property <int> close-behavior;
    in-out property <bool> multiple-games;
    in property <bool> autostart-supported: true;
    in-out property <bool> autostart;
    callback language-changed(int);
    callback close-changed(int);
    callback multiple-changed(bool);
    callback autostart-changed(bool);

    // Apariencia.
    in property <[StyleCard]> styles;
    in property <int> style;
    // Hay imagen propia guardada; `uses-image` = está elegida.
    in property <bool> has-image;
    in property <bool> uses-image;
    in property <image> image-thumb;
    // 0 del estilo, 1 automático (de la imagen), 2 preset.
    in property <int> accent-mode;
    in property <[color]> presets;
    in property <int> preset: -1;
    // 0..1 del máximo (40 de desenfoque, 0,85 de oscurecido).
    in property <float> blur;
    in property <float> dim;
    in property <bool> tunable;
    in-out property <bool> performance;
    callback style-changed(int);
    callback background-style;
    callback background-image;
    callback pick-image;
    callback accent-style;
    callback accent-auto;
    callback accent-preset(int);
    callback blur-changed(float);
    callback dim-changed(float);
    callback performance-changed(bool);

    // Juego.
    in property <int> memory-mb: 4096;
    in property <int> total-mb;
    in-out property <string> jvm-args;
    callback memory-changed(int);
    callback jvm-changed(string);

    // Java.
    in property <LoadState> java-state: LoadState.loading;
    in property <string> java-error;
    in property <string> java-error-detail;
    in property <[JavaItem]> javas;
    in property <[JavaInstallItem]> installs;
    in property <string> install-description;
    in property <bool> java-installing;
    callback java-rescan;
    callback java-install(int);

    // Descargas.
    in property <int> concurrency: 8;
    callback concurrency-changed(int);

    // Integraciones.
    in-out property <bool> discord;
    callback discord-changed(bool);

    // Acerca de.
    in property <string> core-version;
    // Fila de actualizaciones sin versión nueva: texto y «Buscando…».
    in property <bool> update-details;
    in property <string> update-description;
    in property <bool> update-checking;
    callback check-updates;
    in-out property <bool> auto-updates;
    callback auto-updates-changed(bool);
    in property <string> data-dir;
    callback copy-data-dir;
    in property <bool> msa-configured;
}

// SettingsGroup: icono y título (titleMedium) encima de un panel con relleno
// 20 × 8.
component SettingsGroup inherits VerticalLayout {
    in property <string> title;
    in property <string> icon;
    accessible-role: groupbox;
    accessible-label: title;
    HorizontalLayout {
        padding-left: 4px;
        padding-bottom: 8px;
        spacing: 8px;
        Icon { glyph: root.icon; size: 18px; color: Palette.accent; y: (parent.height - self.height) / 2; }
        Txt { text: root.title; style: Type.title-medium; horizontal-stretch: 1; }
    }
    Rectangle {
        border-radius: Theme.radius-card;
        background: Palette.card(Palette.surface1);
        border-width: 1px;
        border-color: Palette.border;
        accessible-role: groupbox;
        accessible-id: "panel";
        VerticalLayout {
            padding-left: 21px;
            padding-right: 21px;
            padding-top: 9px;
            padding-bottom: 9px;
            @children
        }
    }
}

// Tarjeta de estilo o de fondo (_BackgroundOption): miniatura de 92 de alto
// con borde (2 y acento si está elegida) y el nombre debajo.
component BackgroundOption inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    // Contenido: miniatura de estilo, imagen propia o «añadir imagen».
    in property <StyleCard> card;
    in property <bool> is-style: true;
    in property <image> photo;
    in property <bool> has-photo;
    // Botón de lápiz para cambiar la imagen.
    in property <bool> editable;
    callback picked;
    callback edit;
    // Todas del mismo ancho (Expanded).
    min-width: 0;
    preferred-width: 0;
    height: lay.preferred-height;
    accessible-role: button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { picked(); }
    // El nombre también elige el fondo.
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(); } }
    lay := VerticalLayout {
        spacing: 8px;
        Rectangle {
            height: 92px;
            border-radius: Theme.radius-card;
            border-width: root.selected ? 2px : 1px;
            border-color: root.selected ? Palette.accent : Palette.border;
            background: ta.has-hover ? Palette.surface1 : transparent;
            animate border-color { duration: Theme.fast; }
            Rectangle {
                x: 3px + parent.border-width;
                y: 3px + parent.border-width;
                width: parent.width - 2 * self.x;
                height: parent.height - 2 * self.y;
                border-radius: Theme.radius-card - 3px;
                clip: true;
                if root.is-style: Rectangle {
                    // BoxFit.cover de un lienzo de 1280 × 800.
                    property <float> k: max(parent.width / 1280px, parent.height / 800px);
                    width: 1280px * k;
                    height: 800px * k;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    background: root.card.background;
                    if root.card.atmosphere: Atmosphere {
                        width: 1280px;
                        height: 800px;
                        animate: false;
                        transform-scale: parent.k;
                        transform-origin: { x: 0, y: 0 };
                    }
                    if !root.card.atmosphere: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.card.art;
                        image-fit: fill;
                    }
                    Rectangle {
                        x: 96px * parent.k;
                        y: parent.height - (96px + 84px) * parent.k;
                        width: 300px * parent.k;
                        height: 84px * parent.k;
                        border-radius: root.card.radius * 3 * parent.k;
                        background: root.card.accent;
                    }
                }
                if !root.is-style && root.has-photo: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.photo;
                    image-fit: cover;
                }
                if !root.is-style && !root.has-photo: Rectangle {
                    background: Palette.surface1;
                    Icon { glyph: Icons.add-photo-alternate; size: 28px; color: Palette.text-muted; }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            if root.selected: Icon { glyph: Icons.check-circle; filled: true; size: 16px; color: Palette.accent; y: (parent.height - self.height) / 2; }
            Txt {
                text: root.label;
                style: Type.label-large;
                color: root.selected ? Palette.text : Palette.text-secondary;
                horizontal-stretch: 1;
            }
            if root.editable: Rectangle {
                width: 32px;
                height: 18px;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: Theme.radius-control;
                    background: edit-ta.has-hover ? Palette.surface2 : transparent;
                    Icon { glyph: Icons.edit; size: 16px; }
                }
                edit-ta := TipArea { tip: @tr("appearanceChangeImage"); mouse-cursor: pointer; clicked => { root.edit(); } }
            }
        }
    }
}

// Chip de modo del acento (_ModeChip).
component ModeChip inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    width: row.preferred-width;
    height: row.preferred-height;
    border-radius: self.height / 2;
    background: selected ? Palette.accent-container : ta.has-hover ? Palette.surface2 : Palette.surface1;
    border-width: 1px;
    border-color: selected ? Palette.accent.with-alpha(0.6) : Palette.border;
    animate background { duration: Theme.fast; }
    accessible-role: button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-action-default => { clicked(); }
    row := HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 6px;
        Icon { glyph: root.icon; size: 15px; color: root.selected ? Palette.accent : Palette.text-muted; y: (parent.height - self.height) / 2; }
        Txt { text: root.label; style: Type.label-large; color: root.selected ? Palette.on-accent-container : Palette.text-secondary; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Muestra de color del acento (_Swatch): 26 con 6 delante.
component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> selected;
    callback clicked;
    width: 32px;
    height: 26px;
    accessible-role: button;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-label: @tr("appearanceAccent");
    accessible-action-default => { clicked(); }
    Rectangle {
        x: 6px;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: root.swatch;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? Palette.text : #00000040;
        if root.selected: Text {
            text: Icons.check;
            font-family: "ShardIconsFill";
            font-size: 14px;
            color: #101010;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    }
}

// Deslizador con el porcentaje a la derecha (_PercentSlider).
component PercentSlider inherits HorizontalLayout {
    in property <float> value;
    in property <bool> enabled;
    in property <string> label;
    callback changed(float);
    Slider {
        value: clamp(root.value, 0, 1);
        enabled: root.enabled;
        label: root.label;
        changed(v) => { root.changed(v); }
    }
    Txt {
        width: 48px;
        y: (parent.height - self.height) / 2;
        text: round(clamp(root.value, 0, 1) * 100) + " %";
        style: Type.label-large;
        family: "Inter Tnum";
        horizontal-alignment: right;
        color: root.enabled ? Palette.text : Palette.text-muted;
    }
}

// Fila de una Java detectada (_JavaRow).
component JavaRow inherits HorizontalLayout {
    in property <JavaItem> java;
    padding-top: 6px;
    padding-bottom: 6px;
    spacing: 12px;
    accessible-role: AccessibleRole.text;
    accessible-label: java.title;
    Rectangle {
        width: 44px;
        height: 38px;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-control;
        background: Palette.surface2;
        border-width: 1px;
        border-color: Palette.border;
        Txt { width: parent.width; text: root.java.major; style: Type.title-medium; horizontal-alignment: center; }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Txt { text: root.java.title; style: { size: 13.5px, weight: 400, line-height: 1.5, letter-spacing: 0, nudge: -1px }; y: (parent.height - self.height) / 2; }
            ColorBadge {
                y: (parent.height - self.height) / 2;
                text: root.java.source == 0 ? @tr("javaManaged") : root.java.source == 1 ? @tr("javaOverride") : @tr("javaSystem");
                tint: root.java.source == 0 ? Palette.accent : root.java.source == 1 ? Palette.warning : Palette.info;
            }
        }
        Rectangle { height: 2px; }
        Txt { text: root.java.path; style: { size: 11.5px, weight: 400, line-height: 1.5, letter-spacing: 0, nudge: -2px }; family: "JetBrains Mono"; color: Palette.text-muted; }
    }
}

// «Java N»: instalada (✓), instalándose (ruedita) o por instalar.
component InstallButton inherits Rectangle {
    in property <JavaInstallItem> item;
    in property <bool> enabled;
    callback clicked;
    height: 48px;
    width: row.preferred-width;
    accessible-role: button;
    accessible-label: "Java " + item.major;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { clicked(); } }
    Rectangle {
        y: 4px;
        height: 40px;
        border-radius: Theme.radius-control;
        border-width: 1px;
        border-color: root.enabled || root.item.installing ? Palette.border-strong : Palette.text.with-alpha(0.12);
        background: ta.has-hover && root.enabled ? Palette.surface2 : Palette.surface1;
    }
    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;
        if root.item.installing: Spinner { size: 14px; stroke: 2px; y: (parent.height - self.height) / 2; }
        if !root.item.installing: Icon {
            glyph: root.item.installed ? Icons.check : Icons.download;
            size: 16px;
            color: !root.enabled ? Palette.text.with-alpha(0.38) : root.item.installed ? Palette.success : Palette.text;
            y: (parent.height - self.height) / 2;
        }
        Txt { text: "Java " + root.item.major; style: Type.label-large; color: root.enabled ? Palette.text : Palette.text.with-alpha(0.38); y: (parent.height - self.height) / 2; }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Versión nueva en Ajustes (UpdateDetails de update_banner.dart).
component UpdateDetails inherits VerticalLayout {
    padding-top: 12px;
    padding-bottom: 12px;
    Txt { text: @tr("updateAvailableTitle", Notices.update-version); style: Type.title-small; }
    Rectangle { height: 2px; }
    Wrapped {
        text: Notices.update-status;
        style: Type.body-small;
        color: Notices.update-phase == UpdatePhase.failed ? Palette.danger : Palette.text-secondary;
        max-lines: 3;
    }
    Rectangle { height: 12px; }
    if Notices.update-phase == UpdatePhase.installing: Rectangle {
        height: 4px;
        border-radius: 2px;
        clip: true;
        background: Palette.surface2;
        Rectangle {
            x: 0;
            width: Notices.update-progress >= 0 ? parent.width * Notices.update-progress : parent.width * 0.3;
            background: Palette.accent;
        }
    }
    if Notices.update-phase != UpdatePhase.installing: HorizontalLayout {
        alignment: start;
        spacing: 8px;
        if Notices.update-phase == UpdatePhase.ready: FilledButton {
            text: @tr("updateRestart");
            icon: Icons.restart-alt;
            icon-size: 18px;
            clicked => { Notices.update-restart(); }
        }
        if Notices.update-phase != UpdatePhase.ready && Notices.update-can-install: FilledButton {
            text: @tr("updateInstall");
            icon: Icons.download;
            icon-size: 18px;
            clicked => { Notices.update-install(); }
        }
        if Notices.update-phase != UpdatePhase.ready && !Notices.update-can-install: FilledButton {
            text: @tr("updateDownload");
            icon: Icons.open-in-new;
            icon-size: 18px;
            clicked => { Notices.update-download(); }
        }
        if Notices.update-has-notes: VerticalLayout {
            alignment: center;
            TextButton { text: @tr("updateNotes"); clicked => { Notices.update-notes(); } }
        }
    }
}

export component SettingsPage inherits Rectangle {
    property <bool> confirm-cf;
    if SettingsState.state == LoadState.loading: Spinner { }
    if SettingsState.state == LoadState.failed: ErrorNote {
        width: min(560px, parent.width - 64px);
        height: self.preferred-height;
        message: SettingsState.error-message;
        detail: SettingsState.error-detail;
        details-label: @tr("details");
    }
    if SettingsState.state == LoadState.ready: Flickable {
        content-height: page.preferred-height;
        content-y <=> SettingsState.scroll;
        page := VerticalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 4px;
            padding-bottom: 32px;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: min(860px, root.width - 64px);
                    Txt { text: @tr("settingsTitle"); style: Type.headline-medium; accessible-id: "txt-title"; }
                    Rectangle { height: 24px; }

                    SettingsGroup {
                        title: @tr("settingsGeneral");
                        icon: Icons.tune;
                        accessible-id: "group";
                        SettingRow {
                            title: @tr("settingsLanguage");
                            description: @tr("settingsLanguageDesc");
                            SegmentedButton {
                                options: [@tr("languageSystem"), "Español", "English"];
                                selected: SettingsState.language;
                                label: @tr("settingsLanguage");
                                accessible-id: "seg";
                                changed(i) => { SettingsState.language-changed(i); }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("settingsClose");
                            description: @tr("settingsCloseDesc");
                            SegmentedButton {
                                options: [@tr("closeAsk"), @tr("closeTray"), @tr("closeQuit")];
                                selected: SettingsState.close-behavior;
                                label: @tr("settingsClose");
                                accessible-id: "seg";
                                changed(i) => { SettingsState.close-changed(i); }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("settingsMultiple");
                            description: @tr("settingsMultipleDesc");
                            Switch {
                                checked <=> SettingsState.multiple-games;
                                label: @tr("settingsMultiple");
                                accessible-id: "switch";
                                toggled(v) => { SettingsState.multiple-changed(v); }
                            }
                        }
                        if SettingsState.autostart-supported: Divider { }
                        if SettingsState.autostart-supported: SettingRow {
                            title: @tr("settingsAutostart");
                            description: @tr("settingsAutostartDesc", "Shard");
                            Switch {
                                checked <=> SettingsState.autostart;
                                label: @tr("settingsAutostart");
                                accessible-id: "switch";
                                toggled(v) => { SettingsState.autostart-changed(v); }
                            }
                        }
                    }
                    Rectangle { height: 20px; }

                    SettingsGroup {
                        title: @tr("settingsAppearance");
                        icon: Icons.palette;
                        accessible-id: "group";
                        VerticalLayout {
                            padding-top: 12px;
                            padding-bottom: 12px;
                            Txt { text: @tr("appearanceStyle"); style: Type.title-small; }
                            Rectangle { height: 2px; }
                            Wrapped { text: @tr("appearanceStyleDesc"); style: Type.body-small; }
                            Rectangle { height: 12px; }
                            HorizontalLayout {
                                spacing: 12px;
                                for s[i] in SettingsState.styles: BackgroundOption {
                                    horizontal-stretch: 1;
                                    label: s.name;
                                    card: s;
                                    selected: SettingsState.style == i;
                                    accessible-id: "option";
                                    picked => { SettingsState.style-changed(i); }
                                }
                            }
                        }
                        Divider { }
                        VerticalLayout {
                            padding-top: 12px;
                            padding-bottom: 12px;
                            Txt { text: @tr("appearanceBackground"); style: Type.title-small; }
                            Rectangle { height: 2px; }
                            Wrapped { text: @tr("appearanceBackgroundDesc"); style: Type.body-small; }
                            Rectangle { height: 12px; }
                            HorizontalLayout {
                                spacing: 12px;
                                BackgroundOption {
                                    horizontal-stretch: 1;
                                    label: @tr("appearanceBackgroundStyle");
                                    card: SettingsState.styles[SettingsState.style];
                                    selected: !SettingsState.uses-image;
                                    accessible-id: "option";
                                    picked => { SettingsState.background-style(); }
                                }
                                BackgroundOption {
                                    horizontal-stretch: 1;
                                    label: SettingsState.has-image ? @tr("appearanceImage") : @tr("appearancePickImage");
                                    is-style: false;
                                    has-photo: SettingsState.has-image;
                                    photo: SettingsState.image-thumb;
                                    editable: SettingsState.has-image;
                                    selected: SettingsState.uses-image;
                                    accessible-id: "option";
                                    picked => {
                                        if SettingsState.has-image {
                                            SettingsState.background-image();
                                        } else {
                                            SettingsState.pick-image();
                                        }
                                    }
                                    edit => { SettingsState.pick-image(); }
                                }
                                // Mismo ancho de tarjeta que los estilos.
                                Rectangle { horizontal-stretch: 1; min-width: 0; preferred-width: 0; }
                                Rectangle { horizontal-stretch: 1; min-width: 0; preferred-width: 0; }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("appearanceAccent");
                            description: SettingsState.accent-mode == 0 ? @tr("appearanceAccentStyleDesc")
                                : SettingsState.accent-mode == 1 ? @tr("appearanceAccentAutoDesc") : @tr("appearanceAccentDesc");
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                ModeChip {
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.style;
                                    label: @tr("appearanceAccentStyle");
                                    selected: SettingsState.accent-mode == 0;
                                    clicked => { SettingsState.accent-style(); }
                                }
                                if SettingsState.uses-image: ModeChip {
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.auto-awesome;
                                    label: @tr("appearanceAccentAuto");
                                    selected: SettingsState.accent-mode == 1;
                                    clicked => { SettingsState.accent-auto(); }
                                }
                                Rectangle { width: 4px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    for c[i] in SettingsState.presets: Swatch {
                                        y: (parent.height - self.height) / 2;
                                        swatch: c;
                                        selected: SettingsState.accent-mode == 2 && SettingsState.preset == i;
                                        accessible-id: "swatch";
                                        clicked => { SettingsState.accent-preset(i); }
                                    }
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("appearanceBlur");
                            description: @tr("appearanceBlurDesc");
                            control-width: 320px;
                            PercentSlider {
                                value: SettingsState.blur;
                                enabled: SettingsState.tunable && !SettingsState.performance;
                                label: @tr("appearanceBlur");
                                changed(v) => { SettingsState.blur-changed(v); }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("appearanceDim");
                            description: @tr("appearanceDimDesc");
                            control-width: 320px;
                            PercentSlider {
                                value: SettingsState.dim;
                                enabled: SettingsState.tunable;
                                label: @tr("appearanceDim");
                                changed(v) => { SettingsState.dim-changed(v); }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("appearancePerformance");
                            description: @tr("appearancePerformanceDesc");
                            Switch {
                                checked <=> SettingsState.performance;
                                label: @tr("appearancePerformance");
                                accessible-id: "switch";
                                toggled(v) => { SettingsState.performance-changed(v); }
                            }
                        }
                    }
                    Rectangle { height: 20px; }

                    SettingsGroup {
                        title: @tr("settingsGame");
                        icon: Icons.sports-esports;
                        accessible-id: "group";
                        SettingRow {
                            title: @tr("settingsMemory");
                            description: @tr("settingsMemoryDesc", Fmt.memory(SettingsState.total-mb));
                            control-width: 400px;
                            MemorySlider {
                                value-mb: SettingsState.memory-mb;
                                total-mb: SettingsState.total-mb;
                                label: @tr("settingsMemory");
                                changed(v) => { SettingsState.memory-changed(v); }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("settingsJvm");
                            description: @tr("settingsJvmDesc");
                            control-width: 400px;
                            TextField {
                                height: 44px;
                                text <=> SettingsState.jvm-args;
                                placeholder: "-XX:+UseG1GC";
                                font-family: "JetBrains Mono";
                                font-size: 12.5px;
                                accessible-id: "field";
                                edited(t) => { SettingsState.jvm-changed(t); }
                            }
                        }
                    }
                    Rectangle { height: 20px; }

                    SettingsGroup {
                        title: @tr("settingsJava");
                        icon: Icons.coffee;
                        accessible-id: "group";
                        HorizontalLayout {
                            padding-top: 12px;
                            padding-bottom: 8px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Txt { text: @tr("javaDetected"); style: Type.title-small; }
                                Rectangle { height: 2px; }
                                Wrapped { text: @tr("javaDetectedDesc"); style: { size: 12px, weight: 400, line-height: 1.45, letter-spacing: 0 }; }
                            }
                            TonalIconButton {
                                icon: Icons.refresh;
                                tooltip: @tr("javaRescan");
                                fill: transparent;
                                tint: Palette.text-secondary;
                                enabled: SettingsState.java-state != LoadState.loading;
                                clicked => { SettingsState.java-rescan(); }
                            }
                        }
                        if SettingsState.java-state == LoadState.failed: VerticalLayout {
                            padding-top: 8px;
                            padding-bottom: 8px;
                            ErrorNote {
                                message: SettingsState.java-error;
                                detail: SettingsState.java-error-detail;
                                details-label: @tr("details");
                            }
                        }
                        if SettingsState.java-state == LoadState.ready && SettingsState.javas.length == 0: VerticalLayout {
                            padding-top: 12px;
                            padding-bottom: 12px;
                            Wrapped { text: @tr("javaNone"); style: Type.body-small; }
                        }
                        if SettingsState.java-state == LoadState.ready: VerticalLayout {
                            for j in SettingsState.javas: JavaRow { java: j; accessible-id: "java"; }
                        }
                        if SettingsState.java-state == LoadState.loading: VerticalLayout {
                            padding-top: 16px;
                            padding-bottom: 16px;
                            Rectangle { height: 2px; background: Palette.surface2; }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("javaInstall");
                            description: SettingsState.install-description;
                            HorizontalLayout {
                                spacing: 8px;
                                for it in SettingsState.installs: InstallButton {
                                    item: it;
                                    enabled: !SettingsState.java-installing;
                                    accessible-id: "install";
                                    clicked => { SettingsState.java-install(it.major); }
                                }
                            }
                        }
                    }
                    Rectangle { height: 20px; }

                    SettingsGroup {
                        title: @tr("settingsDownloads");
                        icon: Icons.download;
                        accessible-id: "group";
                        SettingRow {
                            title: @tr("settingsConcurrency");
                            description: @tr("settingsConcurrencyDesc");
                            control-width: 400px;
                            HorizontalLayout {
                                spacing: 12px;
                                Slider {
                                    minimum: 1;
                                    maximum: 32;
                                    step: 1;
                                    value: clamp(SettingsState.concurrency, 1, 32);
                                    label: @tr("settingsConcurrency");
                                    changed(v) => { SettingsState.concurrency-changed(round(v)); }
                                }
                                ValueBox { y: (parent.height - self.height) / 2; text: SettingsState.concurrency; }
                            }
                        }
                    }
                    Rectangle { height: 20px; }

                    SettingsGroup {
                        title: @tr("settingsIntegrations");
                        icon: Icons.hub;
                        accessible-id: "group";
                        SettingRow {
                            title: @tr("settingsCurseforge");
                            description: @tr("settingsCurseforgeDesc");
                            HorizontalLayout {
                                spacing: 12px;
                                Tag {
                                    y: (parent.height - self.height) / 2;
                                    text: CurseforgeKey.has-key ? @tr("cfKeySet") : @tr("cfKeyNotSet");
                                    dot: CurseforgeKey.has-key ? Palette.success : Palette.text-muted;
                                }
                                HorizontalLayout {
                                    if CurseforgeKey.has-key: TextButton {
                                        height: 48px;
                                        text: @tr("remove");
                                        clicked => { root.confirm-cf = true; }
                                    }
                                    OutlinedButton {
                                        text: CurseforgeKey.has-key ? @tr("cfKeyChange") : @tr("cfKeyAdd");
                                        icon: Icons.key;
                                        clicked => { CurseforgeKey.open-dialog(); }
                                    }
                                }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("settingsDiscord");
                            description: @tr("settingsDiscordDesc");
                            Switch {
                                checked <=> SettingsState.discord;
                                label: @tr("settingsDiscord");
                                accessible-id: "switch";
                                toggled(v) => { SettingsState.discord-changed(v); }
                            }
                        }
                    }
                    Rectangle { height: 20px; }

                    SettingsGroup {
                        title: @tr("settingsAbout");
                        icon: Icons.info;
                        accessible-id: "group";
                        HorizontalLayout {
                            padding-top: 12px;
                            padding-bottom: 12px;
                            spacing: 16px;
                            BrandMark { size: 40px; y: (parent.height - self.height) / 2; }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Txt { text: "Shard"; style: Type.title-large; }
                                Txt { text: @tr("settingsAboutBody", SettingsState.core-version); style: Type.body-small; color: Palette.text-secondary; }
                            }
                        }
                        Divider { }
                        if SettingsState.update-details: UpdateDetails { }
                        if !SettingsState.update-details: SettingRow {
                            title: @tr("settingsUpdates");
                            description: SettingsState.update-description;
                            OutlinedButton {
                                text: @tr("settingsUpdatesCheck");
                                icon: SettingsState.update-checking ? "" : Icons.refresh;
                                clicked => { if !SettingsState.update-checking { SettingsState.check-updates(); } }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("settingsUpdatesAuto");
                            description: @tr("settingsUpdatesAutoDesc");
                            Switch {
                                checked <=> SettingsState.auto-updates;
                                label: @tr("settingsUpdatesAuto");
                                accessible-id: "switch";
                                toggled(v) => { SettingsState.auto-updates-changed(v); }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("settingsDataDir");
                            description: SettingsState.data-dir;
                            TonalIconButton {
                                icon: Icons.content-copy;
                                tooltip: @tr("copy");
                                fill: transparent;
                                tint: Palette.text-secondary;
                                clicked => { SettingsState.copy-data-dir(); }
                            }
                        }
                        Divider { }
                        SettingRow {
                            title: @tr("settingsMsa");
                            Tag {
                                y: (parent.height - self.height) / 2;
                                text: SettingsState.msa-configured ? @tr("msaConfigured") : @tr("msaNotConfigured");
                                dot: SettingsState.msa-configured ? Palette.success : Palette.warning;
                            }
                        }
                    }
                    // Crédito a Slint, la biblioteca de la interfaz (cortesía:
                    // Shard es GPLv3 y no está obligado a mostrarlo).
                    HorizontalLayout {
                        padding-top: 24px;
                        alignment: center;
                        AboutSlint { }
                    }
                }
            }
        }
    }
    if root.confirm-cf: ConfirmDialog {
        title: @tr("cfKeyRemoveTitle");
        body: @tr("cfKeyRemoveBody");
        action: @tr("remove");
        cancel-label: @tr("cancel");
        danger: true;
        dismissed => { root.confirm-cf = false; }
        accepted => {
            root.confirm-cf = false;
            CurseforgeKey.clear();
        }
    }
}
